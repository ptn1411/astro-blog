---
import { PortableText } from 'astro-portabletext';
import { urlForImage } from '~/utils/sanity/image';

export interface Props {
  value: any;
}

const { value } = Astro.props;

// Custom Components cho Portable Text
const customComponents = {
  type: {
    'horizontal-rule': () => `
      <hr class="my-8 border-t border-slate-300 dark:border-slate-700" />
    `,
    code: ({ node }: any) => {
      const code = node.code || '';
      const lang = node.language || 'plaintext';
      const filename = node.filename;
      return `
        <div class="my-6 rounded-lg overflow-hidden border border-slate-700 bg-slate-950 font-mono text-sm shadow-md">
          ${filename ? `<div class="bg-slate-800 text-slate-300 text-xs px-4 py-2 border-b border-slate-700 font-semibold">${filename}</div>` : ''}
          <pre class="p-4 overflow-x-auto text-slate-100"><code class="language-${lang}">${code.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</code></pre>
        </div>
      `;
    },
    codeBlock: ({ node }: any) => {
      const code = node.code || '';
      const lang = node.language || 'plaintext';
      const filename = node.filename;
      return `
        <div class="my-6 rounded-lg overflow-hidden border border-slate-700 bg-slate-950 font-mono text-sm shadow-md">
          ${filename ? `<div class="bg-slate-800 text-slate-300 text-xs px-4 py-2 border-b border-slate-700 font-semibold">${filename}</div>` : ''}
          <pre class="p-4 overflow-x-auto text-slate-100"><code class="language-${lang}">${code.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</code></pre>
        </div>
      `;
    },
    image: ({ node }: any) => {
      let url = node.src;
      if (node.asset) {
        url = urlForImage(node).auto('format').width(900).url();
      }
      if (!url) return '';
      const alt = node.alt || '';
      const caption = node.caption || node.title;
      return `
        <figure class="my-8 text-center">
          <img src="${url}" alt="${alt}" class="mx-auto rounded-lg shadow-md max-w-full h-auto" loading="lazy" />
          ${caption ? `<figcaption class="mt-2 text-sm text-slate-500 italic">${caption}</figcaption>` : ''}
        </figure>
      `;
    },
    inlineImage: ({ node }: any) => {
      let url = node.src;
      if (node.asset) {
        url = urlForImage(node).auto('format').width(900).url();
      }
      if (!url) return '';
      const alt = node.alt || '';
      const caption = node.caption;
      return `
        <figure class="my-8 text-center">
          <img src="${url}" alt="${alt}" class="mx-auto rounded-lg shadow-md max-w-full h-auto" loading="lazy" />
          ${caption ? `<figcaption class="mt-2 text-sm text-slate-500 italic">${caption}</figcaption>` : ''}
        </figure>
      `;
    },
    table: ({ node }: any) => {
      if (!node.rows || !Array.isArray(node.rows)) return '';
      const headerRows = node.headerRows || 0;
      let html = '<div class="my-6 overflow-x-auto"><table class="w-full text-left border-collapse border border-slate-300 dark:border-slate-700">';
      node.rows.forEach((row: any, rIdx: number) => {
        const isHeader = rIdx < headerRows;
        html += isHeader ? '<tr class="bg-slate-100 dark:bg-slate-800 font-bold">' : '<tr class="border-t border-slate-300 dark:border-slate-700">';
        (row.cells || []).forEach((cell: any) => {
          let text = '';
          if (Array.isArray(cell.value)) {
            text = cell.value.map((b: any) => (b.children || []).map((c: any) => c.text || '').join('')).join(' ');
          } else if (typeof cell.value === 'string') {
            text = cell.value;
          }
          html += isHeader
            ? `<th class="p-3 border border-slate-300 dark:border-slate-700">${text}</th>`
            : `<td class="p-3 border border-slate-300 dark:border-slate-700">${text}</td>`;
        });
        html += '</tr>';
      });
      html += '</table></div>';
      return html;
    },
    callout: ({ node }: any) => {
      const tone = node.tone || 'info';
      const borderColors: Record<string, string> = {
        info: 'border-blue-500 bg-blue-50/50 dark:bg-blue-950/20 text-blue-900 dark:text-blue-200',
        warning: 'border-amber-500 bg-amber-50/50 dark:bg-amber-950/20 text-amber-900 dark:text-amber-200',
        success: 'border-emerald-500 bg-emerald-50/50 dark:bg-emerald-950/20 text-emerald-900 dark:text-emerald-200',
        danger: 'border-rose-500 bg-rose-50/50 dark:bg-rose-950/20 text-rose-900 dark:text-rose-200',
      };
      const cls = borderColors[tone] || borderColors.info;
      return `
        <div class="my-6 p-4 rounded-lg border-l-4 ${cls}">
          <p class="m-0">${node.content || ''}</p>
        </div>
      `;
    },
    youtube: ({ node }: any) => {
      if (!node.url) return '';
      // Trích xuất video ID
      const match = node.url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
      const videoId = match ? match[1] : null;
      if (!videoId) return `<a href="${node.url}" target="_blank" rel="noopener noreferrer">${node.url}</a>`;
      return `
        <div class="my-8 aspect-video w-full overflow-hidden rounded-xl shadow-lg">
          <iframe class="w-full h-full" src="https://www.youtube.com/embed/${videoId}" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      `;
    },
    vimeo: ({ node }: any) => {
      if (!node.url) return '';
      const match = node.url.match(/vimeo\.com\/(\d+)/);
      const videoId = match ? match[1] : null;
      if (!videoId) return `<a href="${node.url}" target="_blank" rel="noopener noreferrer">${node.url}</a>`;
      return `
        <div class="my-8 aspect-video w-full overflow-hidden rounded-xl shadow-lg">
          <iframe class="w-full h-full" src="https://player.vimeo.com/video/${videoId}" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
        </div>
      `;
    },
  },
};
---

<div class="prose dark:prose-invert max-w-none prose-headings:font-heading prose-headings:font-bold prose-a:text-primary dark:prose-a:text-blue-400">
  {value && <PortableText value={value} components={customComponents} />}
</div>
